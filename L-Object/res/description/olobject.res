CONTAINER olobject
{
	NAME olobject;
	INCLUDE Obase;

	// A single group, so that all fields share the same label column
	GROUP ID_OBJECTPROPERTIES
	{
		SEPARATOR SEPARATOR_PRESETS { LINE; }
		GROUP
		{
			COLUMNS 4;
			BUTTON PRESET_L { }
			BUTTON PRESET_C { }
			BUTTON PRESET_CYCLO { }
			BUTTON PRESET_TABLE { }
		}

		REAL WIDTH { UNIT METER; MIN 0; STEP 0.1;}
		REAL THICKNESS { UNIT METER; MIN 0; STEP 0.1;}
		BOOL LEFT_SIDE { }
		BOOL RIGHT_SIDE { }

		SEPARATOR SEPARATOR_FLOOR { LINE; }
		REAL FLOOR_DEPTH { UNIT METER; MIN 0; STEP 0.1;}
		REAL FRONT_HEIGHT { UNIT METER; MIN 0; STEP 0.1;}
		REAL FRONT_RADIUS { UNIT METER; MIN 0; STEP 0.1;}

		SEPARATOR SEPARATOR_WALL { LINE; }
		REAL WALL_HEIGHT { UNIT METER; MIN 0; STEP 0.1;}
		REAL BACK_RADIUS { UNIT METER; MIN 0; STEP 0.1;}

		SEPARATOR SEPARATOR_TOP { LINE; }
		REAL TOP_DEPTH { UNIT METER; MIN 0; STEP 0.1;}
		REAL TOP_RADIUS { UNIT METER; MIN 0; STEP 0.1;}

		SEPARATOR SEPARATOR_SUBDIVISION { LINE; }
		LONG WIDTH_SEGMENTS { MIN 1; STEP 1;}
		LONG CURVE_SEGMENTS { MIN 1; MAX 128; STEP 1;}
	}
}
